#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
AGENT_SYSTEM_DIR="$(dirname "$SCRIPT_DIR")"
PROMPT_FILE="${AGENT_SYSTEM_DIR}/prompts/build-agent.md"

# shellcheck source=../lib/allowed-tools.sh
source "${AGENT_SYSTEM_DIR}/lib/allowed-tools.sh"

# shellcheck source=../lib/agent-session.sh
source "${AGENT_SYSTEM_DIR}/lib/agent-session.sh"

# --- Resolve code directory ---
# If first arg is an existing directory, treat it as code-dir and shift
if [[ -n "${1:-}" && -d "${1:-}" ]]; then
    CODE_DIR="$(cd "$1" && pwd)"
    shift
else
    CODE_DIR="$(pwd)"
fi

# --- Get plan file (remaining arg or interactive prompt) ---
PLAN_FILE="${1:-}"
if [[ -z "$PLAN_FILE" ]]; then
    read -e -p "Plan file: " -i "${CODE_DIR}/" PLAN_FILE
fi

# Resolve relative plan file path against CODE_DIR
if [[ "${PLAN_FILE:0:1}" != "/" ]]; then
    PLAN_FILE="${CODE_DIR}/${PLAN_FILE}"
fi

if [[ ! -f "$PLAN_FILE" ]]; then
    echo "ERROR: Plan file not found at $PLAN_FILE"
    exit 1
fi

# --- Get current branch ---
BRANCH="$(cd "$CODE_DIR" && git rev-parse --abbrev-ref HEAD)"

if [[ ! -f "$PROMPT_FILE" ]]; then
    echo "ERROR: Prompt not found at $PROMPT_FILE"
    exit 1
fi

# --- Confirm before proceeding ---
echo ""
echo "  Directory: $CODE_DIR"
echo "  Branch:    $BRANCH"
echo "  Plan file: $PLAN_FILE"
echo ""
read -r -p "Proceed? [Y/n] " confirm
confirm="${confirm:-Y}"
if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    echo "Aborted."
    exit 0
fi
echo ""

# --- Set tab title ---
eval "$(read_agent_session "$CODE_DIR")" 2>/dev/null || true
TAB_LABEL="${SESSION_feature:-$(basename "$CODE_DIR")}"
set_tab_title "BUILD: ${TAB_LABEL}"

# --- Update session marker to running ---
write_agent_session "$CODE_DIR" state=running agent=build "pid=$$" "started_at=$(date +%s)"

# --- Trap: update marker and reset tab on exit ---
AGENT_EXIT_CODE=0
cleanup() {
    if [[ "$AGENT_EXIT_CODE" -eq 0 ]]; then
        write_agent_session "$CODE_DIR" state=done "pid=" "finished_at=$(date +%s)"
    else
        write_agent_session "$CODE_DIR" state=interrupted "pid=" "finished_at=$(date +%s)"
    fi
    reset_tab_title
}
trap cleanup EXIT

# --- Launch ---
echo "==> Launching build agent"
echo ""

ALLOWED_TOOLS="$GIT_TOOLS $PYTHON_TOOLS $REVIEW_TOOLS $SHELL_TOOLS $FILE_TOOLS"

cd "$CODE_DIR"
set +e
export PLAN_FILE
claude \
    --permission-mode acceptEdits \
    --append-system-prompt "$(envsubst < "$PROMPT_FILE")" \
    --allowedTools "$ALLOWED_TOOLS" \
    "Build the feature."
AGENT_EXIT_CODE=$?
set -e

echo ""
echo "==> Build agent exited."
echo "    Review commits: git log --oneline main..HEAD"
echo "    Push when ready: git push -u origin HEAD"
