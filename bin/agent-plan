#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
AGENT_SYSTEM_DIR="$(dirname "$SCRIPT_DIR")"
PROMPT_FILE="${AGENT_SYSTEM_DIR}/prompts/plan.md"

# shellcheck source=../lib/allowed-tools.sh
source "${AGENT_SYSTEM_DIR}/lib/allowed-tools.sh"

# shellcheck source=../lib/agent-session.sh
source "${AGENT_SYSTEM_DIR}/lib/agent-session.sh"

# --- Use current directory and branch ---
REPO_DIR="$(pwd)"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"

# --- Validate branch format: <user>/<ticket>/<feature-name> ---
branch_slash_count=$(echo "$BRANCH" | tr -cd '/' | wc -c)
if [[ "$branch_slash_count" -ne 2 ]]; then
    echo "ERROR: Branch '${BRANCH}' does not follow the required format: <user>/<ticket>/<feature-name>"
    echo "       Example: eric-shaw/PROJ-123/add-oauth-login"
    exit 1
fi

BRANCH_USER="${BRANCH%%/*}"
_remainder="${BRANCH#*/}"
BRANCH_TICKET="${_remainder%%/*}"
BRANCH_FEATURE="${_remainder#*/}"

if [[ -z "$BRANCH_USER" || -z "$BRANCH_TICKET" || -z "$BRANCH_FEATURE" ]]; then
    echo "ERROR: Branch '${BRANCH}' has empty components. Expected: <user>/<ticket>/<feature-name>"
    exit 1
fi

# --- Derive plan filename ---
TODAY="$(date +%Y-%m-%d)"
PLAN_FILE="${TODAY}-${BRANCH_TICKET}-${BRANCH_FEATURE}.md"

# --- Get plans directory (arg or interactive prompt) ---
PLANS_DIR="${1:-}"
if [[ -z "$PLANS_DIR" ]]; then
    read -e -p "Plans directory: " -i "${REPO_DIR}/" PLANS_DIR
fi

# Resolve relative path against REPO_DIR
if [[ "${PLANS_DIR:0:1}" != "/" ]]; then
    PLANS_DIR="${REPO_DIR}/${PLANS_DIR}"
fi
PLANS_DIR="${PLANS_DIR%/}"

if [[ ! -f "$PROMPT_FILE" ]]; then
    echo "ERROR: Prompt not found at $PROMPT_FILE"
    exit 1
fi

# --- Update session with feature name from branch ---
write_agent_session "$REPO_DIR" "feature=${BRANCH_FEATURE}"

# --- Set tab title ---
set_tab_title "PLAN: ${BRANCH_FEATURE}"

# --- Update session marker to running ---
write_agent_session "$REPO_DIR" state=running agent=plan "pid=$$" "started_at=$(date +%s)"

# --- Trap: update marker and reset tab on exit ---
AGENT_EXIT_CODE=0
cleanup() {
    if [[ "$AGENT_EXIT_CODE" -eq 0 ]]; then
        write_agent_session "$REPO_DIR" state=done "pid=" "finished_at=$(date +%s)"
    else
        write_agent_session "$REPO_DIR" state=interrupted "pid=" "finished_at=$(date +%s)"
    fi
    reset_tab_title
}
trap cleanup EXIT

# --- Announce context ---
echo "==> Starting plan session"
echo "    Directory: $REPO_DIR"
echo "    Branch:    $BRANCH"
echo "    Plan file: ${PLANS_DIR}/${PLAN_FILE}"
echo ""

set +e
claude \
    --permission-mode acceptEdits \
    --append-system-prompt "$(cat "$PROMPT_FILE")" \
    --allowedTools "$GIT_READ_TOOLS $SHELL_TOOLS $REVIEW_TOOLS $FILE_TOOLS" \
    "I want to plan '${BRANCH_FEATURE}' (ticket: ${BRANCH_TICKET}). Write the plan to ${PLANS_DIR}/${PLAN_FILE}. Let's get started — what do you need to know?"
AGENT_EXIT_CODE=$?
set -e
